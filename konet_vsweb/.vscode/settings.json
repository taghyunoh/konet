{
    "files.encoding": "utf8",
    "editor.minimap.enabled": false,
    "git.openRepositoryInParentFolders": "always",
    "git.useEditorAsCommitInput": false,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.configuration.maven.userSettings": "C:\\Users\\HYUN\\.m2\\settings.xml",
    "maven.executable.path": "C:\\egv\\apache-maven-3.8.4\\bin\\mvn.cmd",
    "maven.terminal.useJavaHome": true,
    "maven.terminal.customEnv": [
        {
            "environmentVariable": "JAVA_HOME",
            "value": "C:\\Program Files\\Java\\jre-1.8"
        }
    ],
    "maven.terminal.favorites": [
        {
            "alias": "WAR 빌드 (오프라인)",
            "command": "-o -DskipTests clean package"
        },
        {
            "alias": "WAR 빌드 (의존성 갱신)",
            "command": "-DskipTests clean package"
        }
    ],
    "java.import.maven.enabled": true,
    "java.compile.nullAnalysis.mode": "automatic",
    // [중요] "Java 8 → 최신 LTS 업그레이드" 권유 팝업 차단.
    // 이 프로젝트는 Java 8 전용(pom source/target 1.8)이라 업그레이드하면 기동조차 안 되고,
    // 권유대로 설치되는 modernization 확장이 실제로 소스를 삭제한 사고 이력이 있다(가이드 §6-5).
    "java.dependency.enableDependencyCheckup": false,
    "files.exclude": {
        "**/bin": true,
        "**/target": true
    },
    "search.exclude": {
        "**/bin": true,
        "**/target": true,
        "**/.settings": true
    },
    "files.associations": {
        "*.jsp": "html"
    }
}
