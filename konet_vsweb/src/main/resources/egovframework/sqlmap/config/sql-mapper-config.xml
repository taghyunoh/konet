<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
	<settings>
		<setting name="mapUnderscoreToCamelCase" value="true" />
		<setting name="jdbcTypeForNull" value="NULL" />
	</settings>
	<typeAliases>
		<typeAlias alias="UserDTO"    type="egovframework.konet.user.model.UserDTO"/>
		<typeAlias alias="CompMdDTO"  type="egovframework.konet.user.model.CompMdDTO"/>
		<typeAlias alias="CompConDTO" type="egovframework.konet.user.model.CompConDTO"/>
		<typeAlias alias="CodeMdDTO"  type="egovframework.konet.user.model.CodeMdDTO"/>
		<typeAlias alias="FaqDTO"     type="egovframework.konet.admin.model.FaqDTO"/>
		<typeAlias alias="AsqDTO"     type="egovframework.konet.admin.model.AsqDTO"/>
		<typeAlias alias="CommDTO"    type="egovframework.konet.admin.model.CommDTO"/>
 	    <typeAlias alias="SjgnDTO"    type="egovframework.konet.user.model.SjgnDTO"/>
	</typeAliases>

	<!-- 다중회사(멀티테넌트) — 모든 SQL 실행 직전 로그인 회사코드(compCd) 자동 주입
	     (CompCdFilter 가 세션 s_comp_cd 를 ThreadLocal 에 실어 두면 여기서 파라미터에 채운다) -->
	<plugins>
		<plugin interceptor="egovframework.konet.cmmn.CompCdMybatisInterceptor"/>
	</plugins>

</configuration>
