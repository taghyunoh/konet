<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
     
  <display-name>egov.sample</display-name>
  <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>utf-8</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <!-- konet_vsapp : 모바일(PWA) 요청 가드 — 헤더 X-Konet-M 가 달린 요청인데 로그인 세션이 없으면 401.
       기존 엔드포인트는 세션을 안 봐서 끊긴 세션으로 저장하면 기본 회사로 들어간다(MobileGuardFilter 주석).
       헤더가 없는 요청(PC 화면)은 그대로 통과한다. -->
  <filter>
    <filter-name>mobileGuardFilter</filter-name>
    <filter-class>egovframework.sejong.mobile.web.MobileGuardFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>mobileGuardFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <!-- 다중회사(멀티테넌트) — 로그인 세션(s_comp_cd)의 회사코드를 요청 스레드에 실어
       MyBatis 인터셉터(CompCdMybatisInterceptor)가 모든 SQL 에 compCd 를 자동 주입하게 한다 -->
  <filter>
    <filter-name>compCdFilter</filter-name>
    <filter-class>egovframework.sejong.cmmn.CompCdFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>compCdFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>HTMLTagFilter</filter-name>
    <filter-class>org.egovframe.rte.ptl.mvc.filter.HTMLTagFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>HTMLTagFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>classpath*:egovframework/spring/context-*.xml</param-value>
  </context-param>
  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>
  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>/WEB-INF/config/egovframework/springmvc/dispatcher-servlet.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>
  
  <welcome-file-list>
    <welcome-file>index.do</welcome-file>
  </welcome-file-list>
  <!-- konet_vsapp : 세션 쿠키 이름을 web(JSESSIONID)과 다르게 둔다.
       localhost 쿠키는 포트를 가리지 않아 9071(web)·9072(app)을 같은 브라우저로 열면
       같은 이름의 쿠키를 서로 덮어써 한쪽 로그인이 끊긴다. -->
  <session-config>
    <cookie-config>
      <name>KONETAPP_SID</name>
    </cookie-config>
    <!-- 세션은 쿠키로만 잇는다 — 없으면 첫 요청의 넘김 주소에 ;KONETAPP_SID=… 가 붙는다(운영 2026-09-11 실측) -->
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <login-config>
    <auth-method>BASIC</auth-method>
  </login-config>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/common/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/common/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/common/error.jsp</location>
  </error-page>
</web-app>